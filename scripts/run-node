#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PRESET="default"
BUILD_DIR="${ROOT_DIR}/build"

if command -v ninja >/dev/null 2>&1; then
  PRESET="ninja"
  BUILD_DIR="${ROOT_DIR}/build-ninja"
fi

cmake --preset "${PRESET}"
cmake --build --preset "${PRESET}"
"${BUILD_DIR}/NuclearITHack2026"
